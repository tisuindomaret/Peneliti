# ==========================================
# Environment Variables Example
# ==========================================
# DO NOT ADD REAL SECRETS TO THIS FILE
# Copy this file to .env to configure your local environment
# ==========================================

# --- App Settings ---
NODE_ENV=development
APP_PORT=3001
FRONTEND_PORT=3000

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=rpl_user
DB_PASSWORD=rpl_password
DB_NAME=rpl_db
# Connection URL format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public

# --- Redis / BullMQ ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Authentication ---
# Generate a strong secret in production
JWT_SECRET=super_secret_jwt_key_placeholder
JWT_EXPIRATION_TIME=1d

# --- Email / SMTP (MailHog for local) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@research-permit.example.com

# --- Storage ---
# Path relative to the backend root or absolute path where uploads are saved
STORAGE_PATH=./uploads

# --- Application URLs ---
# The public base URL of the frontend (used for QR code links, email links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# The public base URL of the backend API
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
